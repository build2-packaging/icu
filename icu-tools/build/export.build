n = $name($import.target)
e = $extension($import.target)

# If the target is `file{icudt?.dat}`, export the ICU data archive; otherwise
# export one of the tools.
#
if ($string.starts_with($n, 'icudt') && $e == 'dat')
{
  $out_root/
  {
    include data/
  }

  # The imported target should be either file{icudtl.dat} for little-endian or
  # file{icudtb.dat} for big-endian.

  # Data basename. E.g. `icu74dt`.
  #
  db = $($out_root/data/ data_basename)

  # Imported endianness (the endianness character on the imported target).
  #
  ie = $regex.replace($n, '.+(.)$', '\1')

  export $out_root/data/file{$(db)$(ie).dat} # file{icudt74l} | file{icudt74b}
}
elif ($import.target == exe{uconv})
{
  $out_root/
  {
    include extra/uconv/
  }

  export $out_root/extra/uconv/$import.target
}
else
{
  $out_root/
  {
    include tools/
  }

  # tools/genrb/exe{derb} is unique in that it is in another tool's
  # subdirectory.
  #
  d = [dir_path] ($import.target == exe{derb} ? genrb/ : $n/)

  export $out_root/tools/$d/$import.target
}
